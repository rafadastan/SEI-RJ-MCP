# Copie este arquivo para .env e preencha os valores.
# O arquivo .env esta no .gitignore e nunca deve ser versionado.

# --- PostgreSQL ---
POSTGRES_DB=sei_monitor
POSTGRES_USER=sei_monitor_app
# Use uma senha longa e sem ponto e virgula (a connection string e montada por concatenacao).
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
POSTGRES_PORT=5432

# --- Aplicacao ---
APP_PORT=8080

# Chave de API do endpoint MCP. Obrigatoria em Production.
# Gere com: openssl rand -base64 48   (ou PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })))
SEGURANCA_API_KEY=defina_uma_chave_aleatoria_com_48_bytes_ou_mais

# Intervalo do monitoramento em minutos (0 desativa).
SEI_MONITOR_INTERVAL_MINUTES=30

# Hosts aceitos pelo Kestrel. Em producao, informe o dominio real.
# Ex.: ALLOWED_HOSTS=sei-monitor.exemplo.gov.br
ALLOWED_HOSTS=*

# --- Execucao local sem Docker ---
# Ao rodar com "dotnet run", a aplicacao tambem aceita SEI_DB_PASSWORD/PGPASSWORD
# ou PGPASSFILE (ex.: %APPDATA%\postgresql\pgpass.conf) quando nao ha connection string.
