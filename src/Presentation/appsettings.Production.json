{
  "Seguranca": {
    "ExigirAutenticacao": true,
    "AllowedOrigins": []
  },
  "SeiMonitor": {
    "IntervalMinutes": 30,
    "DelayBetweenProcessesSeconds": 2,
    "CycleTimeoutSeconds": 1800,
    "StartupDelaySeconds": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
